// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    //// Replace this comment with your code.
    // Calculate the incremented value of the current register output
    Inc16(in=regOut, out=incOut);

    // Select incremented value if inc is set
    Mux16(a=regOut, b=incOut, sel=inc, out=outInc);

    // Select input value if load is set (overrides inc)
    Mux16(a=outInc, b=in, sel=load, out=outLoad);

    // Select zero if reset is set (overrides load and inc)
    Mux16(a=outLoad, b=false, sel=reset, out=nextVal);

    // Check if the register needs to update (if any control signal is true)
    Or(a=reset, b=load, out=or1);
    Or(a=or1, b=inc, out=loadReg);

    // Store and output the calculated value
    Register(in=nextVal, load=loadReg, out=regOut, out=out);
}